    config BRIDGE_HOST
        string "Bridge server IP"
        default "192.168.1.109"

    config BRIDGE_PORT
        int "Bridge server port"
        default 5678

    config BRIDGE_PATH
        string "Bridge server quota path"
        default "/quota"
endmenu

menu "MQTT Configuration"
    config MQTT_HOST
        string "MQTT broker IP"
        default "192.168.1.109"

    config MQTT_PORT
        int "MQTT broker port"
